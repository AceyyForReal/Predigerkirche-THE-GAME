  m_TableData:
  - m_Id: 2756092076032
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442! \u041B\u0430\u0441\u043A\u0430\u0432\u043E
      \u043F\u0440\u043E\u0441\u0438\u043C\u043E \u0434\u043E \u0446\u0435\u0440\u043A\u0432\u0438
      \u041F\u0440\u0435\u0434\u0456\u0433\u0435\u0440\u043A\u0456\u0440\u0445\u0435
      \u0432 \u0415\u0440\u0444\u0443\u0440\u0442\u0456! \u042F \u043F\u0430\u0441\u0442\u043E\u0440
      \u0410\u043A\u0435\u0440\u043C\u0430\u043D, \u0456 \u044F \u043F\u043E\u043A\u0430\u0436\u0443
      \u0432\u0430\u043C \u0446\u0435\u0440\u043A\u0432\u0443. \u0426\u0435\u0440\u043A\u0432\u0430
      \u2013 \u0446\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0456\u0441\u0446\u0435
      \u0434\u043B\u044F \u0431\u043E\u0433\u043E\u0441\u043B\u0443\u0436\u0456\u043D\u044C,
      \u0446\u0435 \u0449\u0435 \u0439 \u0447\u0430\u0441\u0442\u0438\u043D\u0430
      \u0456\u0441\u0442\u043E\u0440\u0456\u0457. \u0422\u0443\u0442 \u043C\u043E\u0436\u043D\u0430
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0431\u0430\u0433\u0430\u0442\u043E
      \u0440\u0456\u0437\u043D\u0438\u0445 \u0440\u0435\u0447\u0435\u0439; \u0432\u043E\u043D\u0438
      \u043F\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u0456 \u0436\u043E\u0432\u0442\u0438\u043C
      \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C. \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438
      \u043D\u0430 \u043E\u0431\u2019\u0454\u043A\u0442\u0438, \u0456 \u044F \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u043C
      \u0432\u0430\u043C \u043F\u0440\u043E \u043D\u0438\u0445 \u0446\u0456\u043A\u0430\u0432\u0456
      \u0440\u0435\u0447\u0456! \u041A\u043E\u0436\u0435\u043D \u0456\u0437 \u0446\u0438\u0445
      \u043E\u0431\u2019\u0454\u043A\u0442\u0456\u0432 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0454
      \u0441\u0432\u043E\u044E \u0456\u0441\u0442\u043E\u0440\u0456\u044E \u2013
      \u043F\u0440\u043E \u043B\u044E\u0434\u0435\u0439, \u044F\u043A\u0456 \u0442\u0443\u0442
      \u0436\u0438\u043B\u0438, \u043F\u0440\u043E \u0432\u0430\u0436\u043B\u0438\u0432\u0456
      \u043F\u043E\u0434\u0456\u0457 \u0442\u0430 \u043F\u0440\u043E \u0432\u0456\u0440\u0443,
      \u044F\u043A\u0430 \u0437\u0432\u043E\u0440\u0443\u0448\u0438\u043B\u0430 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
      \u043B\u044E\u0434\u0435\u0439. \u0420\u043E\u0437\u0432\u0430\u0436\u0430\u0439\u0442\u0435\u0441\u044F
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0432\u0430\u0448\u043E\u0457 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0456
      \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u0456\u0432 \u041F\u0440\u0435\u0434\u0456\u0433\u0435\u0440\u043A\u0456\u0440\u0445\u0435!"
    m_Metadata:
      m_Items: []
