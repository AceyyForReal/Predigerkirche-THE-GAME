  - m_Id: 31328294903808
    m_Localized: "\u0421\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u0430 \u0414\u0456\u0432\u0438
      \u041C\u0430\u0440\u0456\u0457, \u044F\u043A\u0443 \u0449\u0435 \u043D\u0430\u0437\u0438\u0432\u0430\u044E\u0442\u044C
      \xAB\u0428\u043C\u0435\u0434\u0435\u0448\u0442\u0435\u0434\u0442\u0441\u044C\u043A\u0430
      \u041C\u0430\u0434\u043E\u043D\u043D\u0430\xBB, \u0454 \u0447\u0430\u0441\u0442\u0438\u043D\u043E\u044E
      \u043E\u0440\u0438\u0433\u0456\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043E\u0437\u0434\u043E\u0431\u043B\u0435\u043D\u043D\u044F \u0435\u043A\u0440\u0430\u043D\u0443
      \u0445\u043E\u0440\u0443 \u0440\u0430\u0437\u043E\u043C \u0456\u0437 \u043F\u0430\u043D\u0435\u043B\u043B\u044E
      \u0440\u043E\u0437\u043F\u2019\u044F\u0442\u0442\u044F. \u0407\u0457 \u0444\u043E\u0440\u043C\u0430
      \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \u0432\u0440\u0430\u0436\u0430\u0454:
      \u0441\u0442\u0440\u0443\u043D\u043A\u0435 \u0442\u0456\u043B\u043E \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043E
      \u0435\u043B\u0435\u0433\u0430\u043D\u0442\u043D\u043E\u044E S-\u043B\u0456\u043D\u0456\u0454\u044E,
      \u044F\u043A\u0430 \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u0456\u0434\u043A\u0440\u0435\u0441\u043B\u044E\u0454\u0442\u044C\u0441\u044F
      \u0443 \u0432\u0435\u0440\u0445\u043D\u0456\u0439 \u0447\u0430\u0441\u0442\u0438\u043D\u0456
      \u043E\u0431\u043B\u044F\u0433\u0430\u044E\u0447\u0438\u043C \u043E\u0434\u044F\u0433\u043E\u043C.
      \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0447\u0456\u0442\u043A\u043E
      \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438 \u0444\u043E\u0440\u043C\u0438
      \u0442\u0456\u043B\u0430 \u043F\u0456\u0434 \u043D\u0438\u043C. \u0423\u043D\u0438\u0437\u0443,
      \u043E\u0434\u043D\u0430\u043A, \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438
      \u0431\u0430\u0433\u0430\u0442\u043E \u0434\u043E\u0432\u0433\u0438\u0445 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u0438\u0445
      \u0441\u043A\u043B\u0430\u0434\u043E\u043A \u043D\u0430 \u0442\u043A\u0430\u043D\u0438\u043D\u0456,
      \u044F\u043A\u0456 \u043C\u0430\u0439\u0436\u0435 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u043F\u0440\u0438\u0445\u043E\u0432\u0443\u044E\u0442\u044C \u043D\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1150275190759424
    m_Localized: "<b>\u0412\u0447\u0438\u0442\u0435\u043B\u0456, \u044F\u043A\u0456
      \u043A\u0443\u0440\u0443\u0432\u0430\u043B\u0438 \u043D\u0430\u0448 \u043F\u0440\u043E\u0435\u043A\u0442:</b>\r\n\r\n\u041D\u0430
      \u0440\u0430\u043D\u043D\u0456\u0439 \u0441\u0442\u0430\u0434\u0456\u0457 \u0440\u043E\u0437\u0432\u0438\u0442\u043A\u0443:\r\n<i>\u041F\u0430\u043D\u0456
      \u0414\u043E\u043A\u0442\u043E\u0440 \u0411\u043B\u0430\u0437\u0456\u0443\u0441</i>\r\n\r\n\u041D\u0430
      \u043F\u0456\u0437\u043D\u0456\u0439 \u0441\u0442\u0430\u0434\u0456\u0457 \u0440\u043E\u0437\u0432\u0438\u0442\u043A\u0443:\r\n<i>\u041C\u0456\u0441\u0442\u0435\u0440
      \u041A\u0432\u0435\u043D\u0442</i>\r\n\r\n\r\n<b>\u041D\u0430\u0448\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0440\u043E\u0437\u0440\u043E\u0431\u043D\u0438\u043A\u0456\u0432:</b>\r\n\r\n<b>\u0410\u0434\u0440\u0456\u0430\u043D
      \u0415.</b>\r\n\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u0443\u0432\u0430\u043D\u043D\u044F,
      3D-\u0441\u043A\u0430\u043D\u0443\u0432\u0430\u043D\u043D\u044F, \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F,
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F, \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0456
      \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F, \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F\r\n\r\n<b>\u0414\u043C\u0438\u0442\u0440\u043E
      \u0410.</b>\r\n\u041C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F,
      \u0456\u0433\u0440\u043E\u0432\u0435 \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F,
      \u043E\u043F\u043E\u0440\u043D\u0456 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F,
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F\r\n\r\n<b>\u0413\u0430\u0431\u0440\u0456\u0435\u043B\u044C
      \u0420.</b>\r\n\u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F,
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F,
      \u0435\u0442\u0430\u043B\u043E\u043D\u043D\u0456 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F,
      \u0456\u0433\u0440\u043E\u0432\u0435 \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043D\u043D\u044F\r\n\r\n<b>\u0410\u043B\u0435\u043A\u0441.
      \u041B.</b>\r\n\u0414\u043E\u0432\u0456\u0434\u043A\u043E\u0432\u0456 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F,
      \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F, \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F\r\n\r\n\r\n<b>\u0410\u043A\u0442\u0438\u0432\u0438
      \u0442\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u0438:</b>\r\n\r\n<b>\u0421\u043A\u0430\u0439\u0431\u043E\u043A\u0441</b>\r\n\u041F\u043E\u043B\u0456\u0445\u0435\u0439\u0432\u0435\u043D\r\n\r\n<b>\u041C\u043E\u0434\u0435\u043B\u044C
      \u0433\u0440\u0430\u0432\u0446\u044F (\u043C\u043E\u0434\u0438\u0444\u0456\u043A\u043E\u0432\u0430\u043D\u0430)</b>\r\n\u041C\u0430\u043A\u0441\u0438\u043C66410\r\n\r\n<b>\u0428\u0443\u043A\u0438
      \u043A\u0440\u043E\u043A\u0456\u0432</b>\r\n\u0421\u0442\u0443\u0434\u0456\u044F
      \u0424\u0435\u0441\u043B\u0456\u044F\u043D\r\n\r\n<b>\u0424\u043E\u043D\u043E\u0432\u0430
      \u043C\u0443\u0437\u0438\u043A\u0430</b>\r\n\u0421\u0442\u0443\u0434\u0456\u044F
      \u0424\u0435\u0441\u043B\u0456\u044F\u043D\r\n\r\n<b>\u0422\u0435\u043A\u0441\u0442\u0443\u0440\u0438
      \u043F\u0456\u0441\u043A\u043E\u0432\u0438\u043A\u0430</b>\r\n\u041F\u043E\u043B\u0456\u0445\u0435\u0439\u0432\u0435\u043D\r\n\r\n<b>\u0406\u043D\u0448\u0456
      \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u0438</b>\r\nAmbientCG, Polyhaven\r\n\r\n\r\n<b>\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u0430
      \u043F\u043E\u0434\u044F\u043A\u0430:</b>\r\n<i>\u041C\u0456\u0441\u0442\u0435\u0440
      \u041F\u0430\u0441\u0442\u043E\u0440 \u0410\u043A\u0435\u0440\u043C\u0430\u043D\u043D</i>\r\n\u0437\u0430
      \u0437\u0430\u043F\u0438\u0441 \u0441\u0432\u043E\u0433\u043E \u0433\u043E\u043B\u043E\u0441\u0443
      \u0432 \u043F\u0440\u043E\u0435\u043A\u0442\u0456\r\n\r\n\u0422\u0435\u0441\u0442
      \u0433\u0440\u0430\u0432\u0446\u0456\u0432\r\n\u0437\u0430 \u0446\u0456\u043D\u043D\u0456
      \u0432\u0456\u0434\u0433\u0443\u043A\u0438 \u0442\u0430 \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0457
      \u0449\u043E\u0434\u043E \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u044F\r\n\r\n\xA9
      2025 Crisis Portabe"
