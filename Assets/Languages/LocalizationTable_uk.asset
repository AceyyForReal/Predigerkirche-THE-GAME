    m_Localized: "\u0433\u043B\u0438\u0431\u0438\u043D\u0430 \u0440\u0456\u0437\u043A\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 11163310202880
    m_Localized: "\u0410\u043C\u0431\u0456\u0435\u043D\u0442\u043D\u0430 \u043E\u043A\u043B\u044E\u0437\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 11649539088384
    m_Localized: "\u0413\u0443\u0447\u043D\u0456\u0441\u0442\u044C \u043C\u0443\u0437\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 11731701309440
    m_Localized: "\u0413\u0443\u0447\u043D\u0456\u0441\u0442\u044C \u0434\u0456\u0430\u043B\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 11846813982720
    m_Localized: "\u041E\u0431\u0441\u044F\u0433 \u0435\u0444\u0435\u043A\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 11975050633216
    m_Localized: "\u041D\u0456\u043C\u0435\u0446\u044C\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 12020915347456
    m_Localized: "\u0430\u043D\u0433\u043B\u0456\u0439\u0441\u044C\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 12041089949696
    m_Localized: "\u0443\u043A\u0440\u0430\u0457\u043D\u0441\u044C\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 26783519055872
    m_Localized: "\u0413\u0440\u043E\u0431\u043D\u0438\u0446\u044F \u0413\u044E\u043D\u0442\u0435\u0440\u0430
      \u0444\u043E\u043D \u0428\u0432\u0430\u0440\u0446\u0431\u0443\u0440\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 27028156030976
    m_Localized: "\u0490\u044E\u043D\u0442\u0435\u0440 \u0444\u043E\u043D \u0428\u0432\u0430\u0440\u0446\u0431\u0443\u0440\u0433
      \u0431\u0443\u0432 \u0433\u0440\u0430\u0444\u043E\u043C \u0456\u0437 \u0422\u044E\u0440\u0456\u043D\u0433\u0456\u0457
      \u0442\u0430 \u0431\u0443\u0432 \u043E\u0431\u0440\u0430\u043D\u0438\u0439
      \u0440\u0438\u043C\u0441\u044C\u043A\u043E-\u043D\u0456\u043C\u0435\u0446\u044C\u043A\u0438\u043C
      \u043A\u043E\u0440\u043E\u043B\u0435\u043C \u0443 1349 \u0440\u043E\u0446\u0456.
      \u041E\u0434\u043D\u0430\u043A \u0447\u0430\u0441 \u0439\u043E\u0433\u043E
      \u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F \u0431\u0443\u0432 \u0434\u043E\u0441\u0438\u0442\u044C
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C, \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0432\u0456\u043D \u043F\u0440\u043E\u0433\u0440\u0430\u0432 \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0443
      \u0437\u0430 \u0432\u043B\u0430\u0434\u0443 \u043F\u0440\u043E\u0442\u0438
      \u041A\u0430\u0440\u043B\u0430 IV. \u0412\u0456\u043D \u0448\u0443\u043A\u0430\u0432
      \u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0443 \u0424\u0440\u0430\u043D\u043A\u0444\u0443\u0440\u0442\u0456-\u043D\u0430-\u041C\u0430\u0439\u043D\u0456,
      \u0430\u043B\u0435 \u0442\u0430\u043C \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E
      \u0437\u0430\u0445\u0432\u043E\u0440\u0456\u0432. \u0417\u0440\u0435\u0448\u0442\u043E\u044E
      \u0432\u0456\u043D \u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u043E
      \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0432\u0441\u044F \u0432\u0456\u0434
      \u043A\u043E\u0440\u043E\u043D\u0438. \u0427\u0435\u0440\u0435\u0437 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0442\u0438\u0436\u043D\u0456\u0432 \u0432\u0456\u043D \u043F\u043E\u043C\u0435\u0440
      \u0456 \u0431\u0443\u0432 \u043F\u043E\u0445\u043E\u0432\u0430\u043D\u0438\u0439
      \u0443 \u0446\u0435\u0440\u043A\u0432\u0456 \u0421\u0432. \u0412\u0430\u0440\u0444\u043E\u043B\u043E\u043C\u0456\u044F.
      \u0419\u043E\u0433\u043E \u0434\u043E\u043B\u044F \u043F\u043E\u043A\u0430\u0437\u0443\u0454,
      \u044F\u043A \u0448\u0432\u0438\u0434\u043A\u043E \u043C\u043E\u0436\u0443\u0442\u044C
      \u0437\u043D\u0438\u043A\u043D\u0443\u0442\u0438 \u0432\u043B\u0430\u0434\u0430
      \u0456 \u0441\u043B\u0430\u0432\u0430, \u0430\u043B\u0435 \u0442\u0430\u043A\u043E\u0436
      \u0442\u0435, \u0449\u043E \u0432\u0435\u043B\u0438\u0447 \u043F\u043E\u043B\u044F\u0433\u0430\u0454
      \u0432 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u0456 \u0433\u0456\u0434\u043D\u043E\u0441\u0442\u0456
      \u0442\u0430 \u043C\u0438\u0440\u0443 \u0443 \u0432\u0430\u0436\u043A\u0456
      \u0445\u0432\u0438\u043B\u0438\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 27877267709952
    m_Localized: "\u0421\u0430\u0432\u043B \u043F\u0435\u0440\u0435\u0434 \u0414\u0430\u043C\u0430\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 27919642763264
    m_Localized: "\u0426\u0435\u0440\u043A\u043E\u0432\u043D\u0456 \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u0456
      \u0432 \u0415\u0440\u0444\u0443\u0440\u0442\u0456 \u0432\u0436\u0435 \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044F\u043B\u0438
      \u043C\u0438\u0441\u0442\u0435\u0446\u044C\u043A\u0456 \u0432\u0438\u0440\u043E\u0431\u0438
      \u0437 \u043B\u0430\u0442\u0443\u043D\u0456 \u0434\u043E 1967 \u0440\u043E\u043A\u0443.
      \u0414\u043E\u0431\u0440\u0435 \u0432\u0456\u0434\u043E\u043C\u0430 \u0456\u0441\u0442\u043E\u0440\u0456\u044F
      \u0437 \u0411\u0456\u0431\u043B\u0456\u0457 \u043F\u0440\u043E \u0421\u0430\u0432\u043B\u0430:
      \u043F\u043E \u0434\u043E\u0440\u043E\u0437\u0456 \u0434\u043E \u0414\u0430\u043C\u0430\u0441\u043A\u0443
      \u0432\u0456\u043D \u0437\u0443\u0441\u0442\u0440\u0456\u0432 \u044F\u0441\u043A\u0440\u0430\u0432\u0435
      \u043D\u0435\u0431\u0435\u0441\u043D\u0435 \u0441\u0432\u0456\u0442\u043B\u043E.
      \u0426\u0435\u0439 \u0434\u043E\u0441\u0432\u0456\u0434 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
      \u0437\u043C\u0456\u043D\u0438\u0432 \u0439\u043E\u0433\u043E \u0436\u0438\u0442\u0442\u044F
      \u2013 \u0433\u043E\u043D\u0438\u0442\u0435\u043B\u044C \u0421\u0430\u0432\u043B
      \u0441\u0442\u0430\u0432 \u041F\u0430\u0432\u043B\u043E\u043C, \u043E\u0434\u043D\u0438\u043C
      \u0456\u0437 \u043D\u0430\u0439\u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0438\u0445
      \u0430\u043F\u043E\u0441\u0442\u043E\u043B\u0456\u0432. \u0419\u043E\u0433\u043E
      \u043F\u0440\u0438\u043A\u043B\u0430\u0434 \u043F\u043E\u043A\u0430\u0437\u0443\u0454,
      \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0432\u0456\u0440\u0430
      \u043C\u043E\u0436\u0435 \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u043B\u044E\u0434\u0438\u043D\u0443.
      \u0419\u043E\u0433\u043E \u043B\u0438\u0441\u0442\u0438 \u0442\u0430 \u0434\u0443\u043C\u043A\u0438
      \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u044E\u0442\u044C \u0444\u043E\u0440\u043C\u0443\u0432\u0430\u0442\u0438
      \u0445\u0440\u0438\u0441\u0442\u0438\u044F\u043D\u0441\u0442\u0432\u043E \u0434\u043E\u043D\u0438\u043D\u0456.
      \u0419\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F
      \u0454 \u0441\u0438\u043B\u044C\u043D\u0438\u043C \u0437\u043D\u0430\u043A\u043E\u043C
      \u043D\u0430\u0434\u0456\u0457 \u0442\u0430 \u043D\u043E\u0432\u0438\u0445
      \u043F\u043E\u0447\u0438\u043D\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 28271582617600
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u0432\u0456\u0432\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 28304239468544
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u0432\u0456\u0432\u0442\u0430\u0440,
      \u043F\u0440\u0438\u0441\u0432\u044F\u0447\u0435\u043D\u0438\u0439 \u0454\u0432\u0430\u043D\u0433\u0435\u043B\u0456\u0441\u0442\u043E\u0432\u0456
      \u0419\u043E\u0430\u043D\u0443, \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0438\u0439
      \u0437\u0456 \u0441\u0445\u0456\u0434\u043D\u043E\u0433\u043E \u0431\u043E\u043A\u0443
      \u0432\u0438\u0441\u043E\u043A\u0438\u0445 \u0445\u043E\u0440\u0456\u0432.
      \u041D\u0438\u0436\u043D\u044F \u0447\u0430\u0441\u0442\u0438\u043D\u0430 \u2014
      \u043A\u0430\u043C\u2019\u044F\u043D\u0430 \u0431\u0440\u0438\u043B\u0430 \u0437\u0456
      \u0441\u043B\u0456\u043F\u0438\u043C\u0438 \u0430\u0440\u043A\u0430\u0434\u0430\u043C\u0438
      \u2014 \u0437 \u0447\u0430\u0441\u0443 \u043F\u043E\u0431\u0443\u0434\u043E\u0432\u0438
      \u0445\u043E\u0440\u0443 (1280 \u0440.). \u0422\u0440\u0438\u0441\u0442\u0443\u043B\u043A\u043E\u0432\u0438\u0439
      \u0440\u0456\u0437\u044C\u0431\u043B\u0435\u043D\u0438\u0439 \u0432\u0456\u0432\u0442\u0430\u0440,
      \u0440\u043E\u0434\u043E\u043C \u0456\u0437 \u0446\u0435\u0440\u043A\u0432\u0438
      \u041F\u0430\u0432\u043B\u0430, \u043F\u0440\u0438\u043A\u0440\u0430\u0448\u0430\u0432
      \u0446\u044E \u043F\u043B\u043E\u0449\u0443 \u0437 XVI \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F.
      \u0428\u0435\u0434\u0435\u0432\u0440 \u041B\u0456\u043D\u0445\u0430\u0440\u0442\u0430
      \u041A\u043E\u043D\u0431\u0435\u0440\u0433\u0430, \u0432\u0438\u0434\u0430\u0442\u043D\u043E\u0433\u043E
      \u0435\u0440\u0444\u0443\u0440\u0442\u0441\u044C\u043A\u043E\u0433\u043E \u043C\u0430\u0439\u0441\u0442\u0440\u0430-\u0440\u0456\u0437\u044C\u0431\u044F\u0440\u0430
      XV \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F, \u0434\u0430\u0442\u043E\u0432\u0430\u043D\u0438\u0439
      1492 \u0440\u043E\u043A\u043E\u043C. \u0417\u043E\u0432\u043D\u0456 \u043D\u0430\u043C\u0430\u043B\u044C\u043E\u0432\u0430\u043D\u0456
      \u0430\u043F\u043E\u0441\u0442\u043E\u043B\u0438 \u041F\u0430\u0432\u043B\u043E
      \u0442\u0430 \u041F\u0435\u0442\u0440\u043E. \u041D\u0430 \u0434\u0440\u0443\u0433\u0456\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u0456 \u0441\u0442\u0443\u043B\u043E\u043A
      \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0456 \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456
      \u0441\u044E\u0436\u0435\u0442\u0438, \u0437\u043E\u043A\u0440\u0435\u043C\u0430
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u043F\u043E\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 28701037404160
    m_Localized: "\u041C\u0435\u0439\u0441\u0442\u0435\u0440 \u0415\u043A\u0445\u0430\u0440\u0442
      \u0456 \u0426\u0435\u0440\u043A\u0432\u0430 \u043F\u0440\u043E\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u043A\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 30219836825600
    m_Localized: "\u041C\u0435\u0439\u0441\u0442\u0435\u0440 \u0415\u043A\u0445\u0430\u0440\u0442
      \u0431\u0443\u0432 \u0432\u0456\u0434\u043E\u043C\u0438\u043C \u043D\u0456\u043C\u0435\u0446\u044C\u043A\u0438\u043C
      \u0442\u0435\u043E\u043B\u043E\u0433\u043E\u043C \u0456 \u043C\u0456\u0441\u0442\u0438\u043A\u043E\u043C.
      \u0423 \u043D\u044C\u043E\u0433\u043E \u0431\u0443\u043B\u0430 \u0456\u0434\u0435\u044F
      \xAB\u043C\u043E\u043B\u0438\u0442\u043E\u0432\u043D\u043E\u0457 \u0446\u0435\u0440\u043A\u0432\u0438\xBB.
      \u0426\u0438\u043C \u0432\u0456\u043D \u043C\u0430\u0432 \u043D\u0430 \u0443\u0432\u0430\u0437\u0456:
      \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u2014 \u0446\u0435 \u0431\u0456\u043B\u044C\u0448\u0435,
      \u043D\u0456\u0436 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0439
      \u0440\u0438\u0442\u0443\u0430\u043B. \u0426\u0435 \u0449\u043E\u0441\u044C
      \u0434\u0443\u0436\u0435 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0435 \u0456
      \u043C\u043E\u0436\u0435 \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u043B\u044E\u0434\u0438\u043D\u0443.
      \u0417\u0430 \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u0415\u043A\u0445\u0430\u0440\u0442\u0430,
      \u043A\u043E\u0436\u043D\u0430 \u043B\u044E\u0434\u0438\u043D\u0430 \u043C\u043E\u0436\u0435
      \u0432\u0441\u0442\u0443\u043F\u0438\u0442\u0438 \u0432 \u043A\u043E\u043D\u0442\u0430\u043A\u0442
      \u0437 \u0411\u043E\u0433\u043E\u043C \u0447\u0435\u0440\u0435\u0437 \u0449\u0438\u0440\u0456
      \u0440\u043E\u0437\u0434\u0443\u043C\u0438 \u0442\u0430 \u043C\u043E\u0432\u0447\u0430\u0437\u043D\u0443
      \u043C\u043E\u043B\u0438\u0442\u0432\u0443. \u0426\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C
      \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u0439 \u0441\u043F\u043E\u043A\u0456\u0439
      \u0456 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u043D\u044F.
      \xAB\u0426\u0435\u0440\u043A\u0432\u0430 \u043C\u043E\u043B\u0438\u0442\u0432\u0438\xBB
      \u0437\u0430\u043F\u0440\u043E\u0448\u0443\u0454 \u043B\u044E\u0434\u0435\u0439
      \u0448\u0443\u043A\u0430\u0442\u0438 \u0431\u043B\u0438\u0437\u044C\u043A\u043E\u0441\u0442\u0456
      \u0411\u043E\u0433\u0430 \u0432 \u0441\u043E\u0431\u0456. \u0422\u0430\u043A\u0438\u043C
      \u0447\u0438\u043D\u043E\u043C \u0432\u043E\u043D\u0438 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0432\u0456\u0434\u0447\u0443\u0442\u0438 \u0441\u0438\u043B\u0443 \u043C\u043E\u043B\u0438\u0442\u0432\u0438
      \u0432 \u043F\u043E\u0432\u0441\u044F\u043A\u0434\u0435\u043D\u043D\u043E\u043C\u0443
      \u0436\u0438\u0442\u0442\u0456 \u0442\u0430 \u0432\u0456\u0434\u0447\u0443\u0442\u0438,
      \u044F\u043A \u0432\u043E\u043D\u0430 \u0437\u043C\u0456\u043D\u044E\u0454
      \u0457\u0445\u043D\u0454 \u0436\u0438\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 30611521904640
    m_Localized: "\u041D\u0430 \u0432\u0438\u0441\u043E\u043A\u043E\u043C\u0443 \u0445\u043E\u0440\u0456
      \u0432\u0438\u0441\u0438\u0442\u044C \u0435\u0444\u0435\u043A\u0442\u043D\u0430
      \u043B\u044E\u0441\u0442\u0440\u0430, \u0442\u0430\u043A \u0437\u0432\u0430\u043D\u0430
      \xAB\u043B\u044E\u0441\u0442\u0440\u0430 \u0413\u0443\u0441\u0442\u0430\u0432\u0430
      \u0410\u0434\u043E\u043B\u044C\u0444\u0430\xBB. \u0412\u0456\u043D \u0431\u0443\u0432
      \u043F\u043E\u0434\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0439 \u0415\u0434\u0443\u0430\u0440\u0434\u043E\u043C
      \u0411\u043E\u0434\u0435 \u0432 1647 \u0440\u043E\u0446\u0456 \u0456 \u043F\u043E\u043A\u0430\u0437\u0443\u0454
      \u0432\u0456\u0441\u0456\u043C \u0444\u0456\u0433\u0443\u0440 \u0430\u043F\u043E\u0441\u0442\u043E\u043B\u0456\u0432.
      \u0426\u0438\u043C \u0441\u0432\u0456\u0447\u043D\u0438\u043A\u043E\u043C \u0411\u043E\u0434\u0435
      \u0445\u043E\u0442\u0456\u0432 \u0432\u0448\u0430\u043D\u0443\u0432\u0430\u0442\u0438
      \u0448\u0432\u0435\u0434\u0441\u044C\u043A\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u044F
      \u0413\u0443\u0441\u0442\u0430\u0432\u0430 II \u0410\u0434\u043E\u043B\u044C\u0444\u0430.
      \u0412\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u0437\u0430 \u0446\u0438\u043C
      \u043A\u0440\u0438\u0454\u0442\u044C\u0441\u044F \u0456 \u0449\u043E\u0441\u044C
      \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0435: \u0415\u0434\u0443\u0430\u0440\u0434
      \u0411\u043E\u0434\u0435 \u043D\u0435 \u043C\u0430\u0432 \u0434\u0456\u0442\u0435\u0439
      \u0456, \u044F\u043A \u043A\u0430\u0436\u0443\u0442\u044C, \u043C\u0430\u0432
      \u0441\u0442\u043E\u0441\u0443\u043D\u043A\u0438 \u0437 \u041C\u0430\u0440\u0456\u0454\u044E
      \u041A\u0440\u043E\u043D\u0434\u043E\u0440\u0444\u0435\u0440\u0456\u043D \u2013
      \u0436\u0456\u043D\u043A\u043E\u044E, \u044F\u043A\u0443 \u0432 \u0442\u043E\u0439
      \u0447\u0430\u0441 \u0437\u043D\u0435\u0432\u0430\u0436\u043B\u0438\u0432\u043E
      \u043D\u0430\u0437\u0438\u0432\u0430\u043B\u0438 \xAB\u0431\u0456\u0434\u043D\u043E\u044E
      \u043F\u043E\u0432\u0456\u0454\u044E\xBB. \u0421\u0432\u0456\u0447\u043D\u0438\u043A
      \u043F\u043E\u0454\u0434\u043D\u0443\u0454 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u0435
      \u043F\u043E\u0447\u0443\u0442\u0442\u044F \u043F\u0440\u043E\u0432\u0438\u043D\u0438
      \u0437 \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C \u043F\u0443\u0431\u043B\u0456\u0447\u043D\u043E
      \u043F\u0440\u043E\u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0443\u0432\u0430\u0442\u0438
      \u0441\u0432\u043E\u044E \u0432\u0456\u0440\u0443. \u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u0432\u0456\u043D \u0432\u0432\u0430\u0436\u0430\u0454\u0442\u044C\u0441\u044F
      \u043C\u043E\u0433\u0443\u0442\u043D\u0456\u043C \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C
      \u043F\u043E\u043A\u0430\u044F\u043D\u043D\u044F, \u043F\u0430\u043C'\u044F\u0442\u0456
      \u0442\u0430 \u043D\u0430\u0434\u0456\u0457 \u043D\u0430 \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0435
      \u043F\u0440\u043E\u0449\u0435\u043D\u043D\u044F."
