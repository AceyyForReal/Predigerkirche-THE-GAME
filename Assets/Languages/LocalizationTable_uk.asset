  - m_Id: 31081011322880
    m_Localized: "\u0419\u043E\u0433\u0430\u043D\u043D\u0435\u0441 \u0410\u0443\u0440\u0456\u0444\u0430\u0431\u0435\u0440,
      \u0442\u0430\u043A\u043E\u0436 \u0432\u0456\u0434\u043E\u043C\u0438\u0439 \u044F\u043A
      \u0419\u043E\u0433\u0430\u043D\u043D \u0490\u043E\u043B\u044C\u0434\u0448\u043C\u0456\u0434\u0442,
      \u0431\u0443\u0432 \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u043C \u0440\u0435\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u043E\u043C
      16 \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F. \u0412\u0456\u043D \u043D\u0430\u0432\u0447\u0430\u0432\u0441\u044F
      \u0443 \u0412\u0456\u0442\u0442\u0435\u043D\u0431\u0435\u0440\u0437\u0456 \u0456
      \u043D\u0430\u0432\u0456\u0442\u044C \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E
      \u043F\u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0432\u0441\u044F \u0437
      \u041C\u0430\u0440\u0442\u0456\u043D\u043E\u043C \u041B\u044E\u0442\u0435\u0440\u043E\u043C,
      \u0447\u0438\u0457 \u0456\u0434\u0435\u0457 \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u043D\u0430 \u043D\u044C\u043E\u0433\u043E \u0441\u0438\u043B\u044C\u043D\u0438\u0439
      \u0432\u043F\u043B\u0438\u0432. Aurifaber \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0432
      \u043F\u043E\u0448\u0438\u0440\u044E\u0432\u0430\u0442\u0438 \u043D\u043E\u0432\u0456
      \u0456\u0434\u0435\u0457 \u0420\u0435\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457
      - \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0447\u0435\u0440\u0435\u0437
      \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u0438 \u0442\u0430 \u043F\u0440\u043E\u043F\u043E\u0432\u0456\u0434\u0456.
      \u0421\u0432\u043E\u0454\u044E \u0432\u0456\u0434\u0434\u0430\u043D\u0456\u0441\u0442\u044E
      \u0432\u0456\u043D \u043C\u0430\u0432 \u0432\u0438\u0440\u0456\u0448\u0430\u043B\u044C\u043D\u0438\u0439
      \u0432\u043F\u043B\u0438\u0432 \u043D\u0430 \u0440\u0435\u043B\u0456\u0433\u0456\u0439\u043D\u0438\u0439
      \u0440\u043E\u0437\u0432\u0438\u0442\u043E\u043A \u0441\u0432\u043E\u0433\u043E
      \u0447\u0430\u0441\u0443."
