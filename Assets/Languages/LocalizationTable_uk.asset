  - m_Id: 8296406949888
    m_Localized: "\u041D\u0430\u0448\u0430 \u0435\u043A\u0441\u043A\u0443\u0440\u0441\u0456\u044F
      \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u0430. \u0410\u043B\u0435
      \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0437\u0438\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u0442\u0443\u0442, \u0443 Predigerkirche, \u0456 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438
      \u0434\u043B\u044F \u0441\u0435\u0431\u0435 \u0432\u0441\u0435 \u043D\u0430
      \u0434\u043E\u0437\u0432\u0456\u043B\u043B\u0456 \u0442\u0430 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0438
      \u0446\u044C\u043E\u043C\u0443 \u043F\u043E\u0434\u0456\u044F\u0442\u0438 \u043D\u0430
      \u0432\u0430\u0441 \u0441\u0432\u043E\u0454\u044E \u043C\u0430\u0433\u0456\u0454\u044E."
